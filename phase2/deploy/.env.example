# Copy to .env and fill in. Never commit .env.

# Public hostname with a DNS A record pointing at this server (Caddy gets the TLS cert for it).
PW_DOMAIN=pw.example.edu

# Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Comma-separated API keys you hand to pilot users, one per user/team so usage is attributable.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PW_API_KEYS=

# Optional: Slack incoming webhook for non-healthy diagnoses.
SLACK_WEBHOOK_URL=

# Optional tuning.
# PW_MODEL=claude-opus-5-5
# PW_EFFORT=medium
# PW_ENGINE=auto
# PW_MAX_UPLOAD_MB=50
